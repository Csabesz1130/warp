# Path to extracted Becker dataset (parquet files for kalshi/markets, kalshi/trades, etc.)
BECKER_DATA_DIR=./prediction-market-analysis/data

# Kalshi API credentials (https://kalshi.com/account/profile)
KALSHI_KEY_ID=your-key-id-here
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi.pem
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2

# For demo/sandbox, switch to:
# KALSHI_API_BASE=https://demo-api.kalshi.co/trade-api/v2
# KALSHI_WS_URL=wss://demo-api.kalshi.co/trade-api/ws/v2

# Strategy parameters
OPTIX_BANKROLL_USD=10000
OPTIX_PER_MARKET_CAP_PCT=1.0
OPTIX_DAILY_DD_HALT_PCT=4.0
OPTIX_TARGET_CATEGORIES=Sports,Entertainment,Media,WorldEvents,Crypto,Weather
OPTIX_LONGSHOT_PRICE_LO_CENTS=1
OPTIX_LONGSHOT_PRICE_HI_CENTS=15
OPTIX_TAKER_IMBALANCE_THRESHOLD=0.6
OPTIX_TAKER_LOOKBACK_TRADES=20

# Set OPTIX_LIVE=1 only when ready for real orders
OPTIX_LIVE=0

# Logging
OPTIX_LOG_DIR=./runs

# JEPA-Forecaster v1 (sklearn prototype + strict gates vs implied-price baseline)
# structural_only = calibration EV only; hybrid / forecast_ablation blend forecaster p(YES).
OPTIX_FORECAST_MODE=structural_only
OPTIX_FORECAST_ARTIFACT_ID=
OPTIX_FORECAST_HYBRID_ALPHA=0.5
OPTIX_FORECAST_ENCODER_EXTRA_DIM=0
OPTIX_FORECAST_TRAIN_FRAC=0.70
OPTIX_FORECAST_VAL_FRAC=0.15
OPTIX_FORECAST_GATE_BRIER_DELTA_MIN=0.005
OPTIX_FORECAST_GATE_LOGLOSS_DELTA_MIN=0.02
OPTIX_FORECAST_GATE_MAX_ECE=0.12
OPTIX_FORECAST_MIN_TEST_SAMPLES=200
OPTIX_FORECAST_MIN_CATEGORIES=3
OPTIX_FORECAST_ECE_BINS=10
OPTIX_FORECAST_MLP_HIDDEN=64,32
OPTIX_FORECAST_MLP_MAX_ITER=400
